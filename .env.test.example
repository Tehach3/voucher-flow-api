# ================================================
# Variables para docker-compose.test.yml
# Copiar a .env.test y ajustar valores
# ================================================

# Puertos expuestos al host
APP_PORT=3000
DB_PORT=5433

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=voucher_flow

# Seguridad — CAMBIAR antes de desplegar
API_KEY=test-api-key-changeme

# CORS
CORS_ORIGIN=*

# Cloudinary (dejar vacío para usar stub local)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
