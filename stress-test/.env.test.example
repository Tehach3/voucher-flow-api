# stress-test/.env.test.example
# Copia este archivo a stress-test/.env.test y rellena los valores reales.
# El archivo .env.test está en .gitignore — nunca lo commitees.

# URL base del servidor a probar (sin / al final)
BASE_URL=https://tu-app.railway.app

# Conexión directa a la BD — usada por cleanup-stress-data.sh para limpiar
# los datos generados por el test. Misma DATABASE_URL que usa Railway/el servidor.
DATABASE_URL=

# Valor del header x-api-key
API_KEY=tu_api_key_aqui

# ID de un evento activo en la BD
EVENTO_ID=1

# HMAC — dejar vacío si SECURITY_HMAC_ENABLED=false en el servidor
HMAC_SECRET=

# Modo del test: "rapido" (1k req, 50 VUs, ~2 min) | "completo" (10k req, 200 VUs, ~6 min)
MODO=completo
