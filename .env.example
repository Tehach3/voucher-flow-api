# ================================================
# APP
# ================================================
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# ================================================
# SECURITY
# ================================================
API_KEY=your_api_key_here

# ================================================
# DATABASE (PostgreSQL / Neon)
# ================================================
DATABASE_URL=
DATABASE_SSL=false

# ================================================
# CLOUDINARY
# ================================================
# Con las tres credenciales configuradas, los tickets se suben a:
#   sorteos/evento-{eventoId}/{numeroTicket}
# Si alguna credencial está vacía, el servicio entra en modo stub automáticamente.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CLOUDINARY_MOCK=true fuerza el modo stub aunque las credenciales estén configuradas.
# Útil para pruebas locales sin consumir cuota de Cloudinary.
# Los uploads devuelven una URL simulada (http://localhost:3000/stub-uploads/...)
# true  → siempre stub (ignorar credenciales)
# false → comportamiento según credenciales (default)
CLOUDINARY_MOCK=false

# ================================================
# ENCRYPTION
# ================================================
ENCRYPTION_KEY=change_me_to_a_long_random_secret_min_32_chars

# ================================================
# SECURITY FEATURES (set to 'true' to enable)
# En desarrollo se recomienda dejar todo en false para evitar fricción
# ================================================

# Propuesta 3 — Firma HMAC de requests
# El cliente debe enviar X-Signature y X-Timestamp en cada POST /api/tickets
SECURITY_HMAC_ENABLED=false
APP_HMAC_SECRET=change_me_to_a_long_random_hmac_secret
SECURITY_HMAC_WINDOW_SECS=300

# Propuesta 4 — Auditoría de eventos de tickets
SECURITY_AUDIT_ENABLED=false

# Propuesta 5 — Hash de imagen para detectar comprobantes reutilizados
SECURITY_IMAGE_HASH_ENABLED=false

# ================================================
# RATE LIMITING
# ================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ================================================
# TEST / DEBUG — solo development, ignorado en production
# ================================================

# FORCE_CLOUDINARY_ERROR — fuerza que el upload a Cloudinary siempre falle.
# El ticket queda guardado en tickets_pendientes con:
#   etapaError = 'upload_imagen'   fotoBufferB64 = <base64 de la imagen>
# Respuesta: 503 con codigo=FAC_007 y pendienteId
# Usar para probar: GET /api/tickets/pendientes y POST /api/tickets/pendientes/:id/reintentar
FORCE_CLOUDINARY_ERROR=false

# FORCE_DB_WRITE_ERROR — fuerza que la escritura en BD falle después del upload.
# La imagen SÍ llega a Cloudinary (o al stub), pero los datos no se guardan.
# El ticket queda guardado en tickets_pendientes con:
#   etapaError = 'escritura_db'   fotoUrl = <url de Cloudinary>
# Respuesta: 503 con codigo=FAC_008 y pendienteId
# Usar para probar: GET /api/tickets/pendientes y POST /api/tickets/pendientes/:id/reintentar
FORCE_DB_WRITE_ERROR=false
