# APP
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# SECURITY
API_KEY=your_api_key_here

# DATABASE
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=2
DATABASE_POOL_IDLE_MS=10000
DATABASE_POOL_TIMEOUT_MS=3000

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_MOCK=false
CLOUDINARY_OCR_ENABLED=false

# Security
SECURITY_HMAC_ENABLED=false
APP_HMAC_SECRET=change_me_to_a_long_random_hmac_secret
SECURITY_HMAC_WINDOW_SECS=300
ENCRYPTION_KEY=change_me_to_a_long_random_secret_min_32_chars
SECURITY_AUDIT_ENABLED=false
SECURITY_IMAGE_HASH_ENABLED=false

# RATE LIMITING
# Producción normal: 100 req/min por IP
# Tests de estrés:   subir a 50000 temporalmente en el servidor
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# TEST
FORCE_CLOUDINARY_ERROR=false
FORCE_DB_WRITE_ERROR=false
